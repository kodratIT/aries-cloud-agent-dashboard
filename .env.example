# ACA-Py Multi-Tenant Configuration
# URL to ACA-Py Admin API
# For local development: http://localhost:8021
# For Docker Compose: http://multi-agent:8021
# For production: https://your-acapy-domain.com
PUBLIC_ACAPY_API_URL=http://localhost:8021

# Server Configuration (Optional)
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production

# Build Configuration
# This is used during Docker build
# Will be overridden by runtime environment variables
# PUBLIC_ACAPY_API_URL=http://multi-agent:8021

# Development Notes:
# - Wallet key is NEVER stored, only used for authentication
# - Each tenant has isolated wallet
# - Token expires after configured time in ACA-Py
# - Save wallet ID and key securely - cannot be recovered!
