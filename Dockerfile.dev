# Development Dockerfile dengan hot reload
FROM node:20-alpine AS development

WORKDIR /app

# Install dependencies
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn

RUN yarn install

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start dev server dengan hot reload
CMD ["yarn", "dev", "--host"]
